  title: "\u0422\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0430 \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0430"
  groups:
  - title: "\u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u043E\u0432"
    intro: "\u041F\u043E\u0440\u044F\u0434\u043E\u043A \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439: 1) \u043F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A \u0441\u0442\u043E\u043B\u0443, 2) \u0432\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u043F\u0430\u0441\u043F\u043E\u0440\u0442, 3) \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C\xBB \u043D\u0430 \u043A\u043E\u043D\u0441\u043E\u043B\u0438."
    steps:
    - id: docs_1
      title: "\u041F\u043E\u0434\u043E\u0439\u0442\u0438 \u043A \u0441\u0442\u043E\u043B\u0443"
      description: "\u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u0435\u043D\u043D\u043E\u0439 \u0437\u043E\u043D\u0435 \u0443 \u0441\u0442\u043E\u043B\u0430."
      actions:
      - type: 0
        targetId: zone_desk
    - id: docs_2
      title: "\u0412\u0437\u044F\u0442\u044C \u043F\u0430\u0441\u043F\u043E\u0440\u0442"
      description: "\u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u0435\u043D\u043D\u044B\u0439 \u043F\u0430\u0441\u043F\u043E\u0440\u0442."
      actions:
      - type: 1
        targetId: passport
    - id: docs_3
      title: "\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442"
      description: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043A\u043D\u043E\u043F\u043A\u0443 \xAB\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C\xBB \u043D\u0430 \u043A\u043E\u043D\u0441\u043E\u043B\u0438."
      actions:
      - type: 3
        targetId: btn_confirm
  - title: "\u041F\u043E\u0438\u0441\u043A \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u0439"
    intro: "\u041F\u043E\u0440\u044F\u0434\u043E\u043A \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439: 1) \u043F\u0440\u043E\u0439\u0434\u0438\u0442\u0435 \u0432 \u0437\u043E\u043D\u0443 \u043E\u0441\u043C\u043E\u0442\u0440\u0430, 2) \u0443\u043A\u0430\u0436\u0438\u0442\u0435 \u043D\u0430 \u044F\u0449\u0438\u043A \u0441 \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u0435\u043C, 3) \u0432\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u0441\u043A\u0430\u043D\u0435\u0440 \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u041E\u0442\u0447\u0451\u0442\xBB."
    steps:
    - id: scan_1
      title: "\u041F\u0440\u043E\u0439\u0442\u0438 \u0432 \u0437\u043E\u043D\u0443 \u043E\u0441\u043C\u043E\u0442\u0440\u0430"
      description: "\u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u0435\u043D\u043D\u043E\u0439 \u0437\u043E\u043D\u0435 \u043E\u0441\u043C\u043E\u0442\u0440\u0430."
      actions:
      - type: 0
        targetId: zone_inspection
    - id: scan_2
      title: "\u041D\u0430\u0439\u0442\u0438 \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u0435"
      description: "\u041A\u043B\u0438\u043A\u043D\u0438\u0442\u0435 \u043B\u0443\u0447\u043E\u043C \u043F\u043E \u043A\u0440\u0430\u0441\u043D\u043E\u043C\u0443 \u044F\u0449\u0438\u043A\u0443 - \u043D\u0430 \u043D\u0451\u043C \u043D\u0435\u0442 \u043F\u043B\u043E\u043C\u0431\u044B."
      actions:
      - type: 2
        targetId: crate_red
    - id: scan_3
      title: "\u0421\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043E\u0442\u0447\u0451\u0442"
      description: "\u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u0441\u043A\u0430\u043D\u0435\u0440, \u0437\u0430\u0442\u0435\u043C \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u041E\u0442\u0447\u0451\u0442\xBB \u043D\u0430 \u043A\u043E\u043D\u0441\u043E\u043B\u0438."
      actions:
      - type: 1
        targetId: scanner
      - type: 3
        targetId: btn_report
  - title: "\u041E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u0438\u0435 \u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435"
    intro: "\u041F\u043E\u0440\u044F\u0434\u043E\u043A \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439: 1) \u043F\u0440\u043E\u0439\u0434\u0438\u0442\u0435 \u0432 \u0430\u0440\u0445\u0438\u0432, 2) \u0432\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u043F\u0430\u043F\u043A\u0443, 3) \u043A\u043B\u0438\u043A\u043D\u0438\u0442\u0435 \u043F\u043E \u043F\u0435\u0447\u0430\u0442\u0438 \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C\xBB."
    steps:
    - id: end_1
      title: "\u041F\u0440\u043E\u0439\u0442\u0438 \u0432 \u0430\u0440\u0445\u0438\u0432"
      description: "\u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u0435\u043D\u043D\u043E\u0439 \u0437\u043E\u043D\u0435 \u0430\u0440\u0445\u0438\u0432\u0430."
      actions:
      - type: 0
        targetId: zone_archive
    - id: end_2
      title: "\u0412\u0437\u044F\u0442\u044C \u043F\u0430\u043F\u043A\u0443"
      description: "\u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u0435\u043D\u043D\u0443\u044E \u043F\u0430\u043F\u043A\u0443."
      actions:
      - type: 1
        targetId: folder
    - id: end_3
      title: "\u0417\u0430\u0432\u0435\u0440\u0438\u0442\u044C \u0438 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C"
      description: "\u041A\u043B\u0438\u043A\u043D\u0438\u0442\u0435 \u043B\u0443\u0447\u043E\u043C \u043F\u043E \u043F\u0435\u0447\u0430\u0442\u0438, \u0437\u0430\u0442\u0435\u043C \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C\xBB."
      actions:
      - type: 2
        targetId: stamp
      - type: 3
        targetId: btn_finish
